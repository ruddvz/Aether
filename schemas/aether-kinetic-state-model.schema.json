{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruddvz.github.io/Aether/schemas/aether-kinetic-state-model.schema.json",
  "title": "AETHERIA VX4800 kinetic commissioning and service state model",
  "type": "object",
  "required": [
    "schemaVersion",
    "fixtureId",
    "modelRevision",
    "status",
    "authority",
    "finalStateModelApproved",
    "states",
    "transitions",
    "operatorUxRequirements",
    "manualRecoveryRules",
    "promotionGate"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"type": "string"},
    "fixtureId": {"const": "vx4800-bf-01"},
    "modelRevision": {"type": "string"},
    "status": {"type": "string"},
    "authority": {"enum": ["engineering-development-input", "controlled"]},
    "finalStateModelApproved": {"type": "boolean"},
    "states": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "motionAllowed", "accessAllowed", "mechanicalConditions"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "motionAllowed": {"type": "boolean"},
          "accessAllowed": {"type": "boolean"},
          "mechanicalConditions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["from", "to", "trigger", "permissives"],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "trigger": {"type": "string"},
          "permissives": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "operatorUxRequirements": {"type": "array", "minItems": 8, "items": {"type": "string"}},
    "manualRecoveryRules": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "promotionGate": {
      "type": "object",
      "required": ["stateTransitionsReviewed", "physicalLockStateVerified", "jogModeValidated", "faultResetValidated", "manualRecoveryValidated", "operatorIndicationsValidated"],
      "properties": {
        "stateTransitionsReviewed": {"type": "boolean"},
        "physicalLockStateVerified": {"type": "boolean"},
        "jogModeValidated": {"type": "boolean"},
        "faultResetValidated": {"type": "boolean"},
        "manualRecoveryValidated": {"type": "boolean"},
        "operatorIndicationsValidated": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"finalStateModelApproved": {"const": true}}, "required": ["finalStateModelApproved"]},
      "then": {
        "properties": {
          "authority": {"const": "controlled"},
          "status": {"const": "approved"},
          "promotionGate": {
            "properties": {
              "stateTransitionsReviewed": {"const": true},
              "physicalLockStateVerified": {"const": true},
              "jogModeValidated": {"const": true},
              "faultResetValidated": {"const": true},
              "manualRecoveryValidated": {"const": true},
              "operatorIndicationsValidated": {"const": true}
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
