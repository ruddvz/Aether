{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetheria.example/schemas/aether-interchange-loss-report.schema.json",
  "title": "AETHERIA interchange loss report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fixtureId",
    "designRevision",
    "authority",
    "target",
    "source",
    "sourceFacts",
    "mappings",
    "losses",
    "summary",
    "authorityBoundary"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": "1.0.0"},
    "fixtureId": {"type": "string", "minLength": 1},
    "designRevision": {"type": "string", "minLength": 1},
    "authority": {"const": "derived-interchange-review"},
    "target": {"enum": ["ifc", "gdtf", "mvr"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixturePath", "fixtureSha256"],
      "properties": {
        "fixturePath": {"type": "string", "minLength": 1},
        "fixtureSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "sourceFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productCode", "envelopeMm", "elementCount", "familyCounts", "suspensionLineCount", "fixedHeadCount", "motionStatus", "opticalStatus", "massStatus"],
      "properties": {
        "productCode": {"type": "string", "minLength": 1},
        "envelopeMm": {
          "type": "array",
          "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}],
          "minItems": 3,
          "maxItems": 3
        },
        "elementCount": {"type": "integer", "minimum": 0},
        "familyCounts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "suspensionLineCount": {"type": "integer", "minimum": 0},
        "fixedHeadCount": {"type": "integer", "minimum": 0},
        "motionStatus": {"type": "string"},
        "opticalStatus": {"type": "string"},
        "massStatus": {"type": "string"}
      }
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourcePath", "targetConcept", "disposition", "authorityImpact", "note"],
        "properties": {
          "sourcePath": {"type": "string", "minLength": 1},
          "targetConcept": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["preserved", "approximated", "omitted", "external-reference"]},
          "authorityImpact": {"enum": ["none", "review-only", "lost"]},
          "note": {"type": "string", "minLength": 1}
        }
      }
    },
    "losses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "sourcePath", "reason", "requiredFollowUp"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z0-9_-]+$"},
          "severity": {"enum": ["info", "warning", "blocking"]},
          "sourcePath": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "requiredFollowUp": {"type": "string", "minLength": 1}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preserved", "approximated", "omitted", "externalReferences", "blockingLosses", "exportEligible", "exportAuthority"],
      "properties": {
        "preserved": {"type": "integer", "minimum": 0},
        "approximated": {"type": "integer", "minimum": 0},
        "omitted": {"type": "integer", "minimum": 0},
        "externalReferences": {"type": "integer", "minimum": 0},
        "blockingLosses": {"type": "integer", "minimum": 0},
        "exportEligible": {"type": "boolean"},
        "exportAuthority": {"enum": ["coordination-only", "blocked"]}
      }
    },
    "authorityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manufacturingAuthority", "structuralAuthority", "photometryAuthority", "kineticSafetyAuthority", "constructionReleaseAuthority"],
      "properties": {
        "manufacturingAuthority": {"const": false},
        "structuralAuthority": {"const": false},
        "photometryAuthority": {"const": false},
        "kineticSafetyAuthority": {"const": false},
        "constructionReleaseAuthority": {"const": false}
      }
    }
  }
}
