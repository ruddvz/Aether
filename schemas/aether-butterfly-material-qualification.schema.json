{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruddvz.github.io/Aether/schemas/aether-butterfly-material-qualification.schema.json",
  "title": "AETHERIA butterfly material and attachment qualification",
  "type": "object",
  "required": [
    "schemaVersion",
    "fixtureId",
    "qualificationRevision",
    "status",
    "finalMaterialSystemApproved",
    "authority",
    "tiers",
    "attachmentConcepts",
    "promotionGate"
  ],
  "properties": {
    "schemaVersion": {"type": "string"},
    "fixtureId": {"type": "string"},
    "qualificationRevision": {"type": "string"},
    "status": {"type": "string"},
    "finalMaterialSystemApproved": {"type": "boolean"},
    "authority": {"enum": ["research-and-rfq-input", "controlled"]},
    "tiers": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "tier",
          "candidateId",
          "manufacturer",
          "material",
          "status",
          "publishedProperties",
          "sourceScope",
          "currentAttachmentDirection",
          "strengths",
          "blockers",
          "sources"
        ],
        "properties": {
          "tier": {"type": "string"},
          "candidateId": {"type": "string"},
          "manufacturer": {"type": ["string", "null"]},
          "material": {"type": "string"},
          "status": {"type": "string"},
          "publishedProperties": {"type": ["object", "null"]},
          "sourceScope": {"type": "string"},
          "currentAttachmentDirection": {"type": "string"},
          "strengths": {"type": "array", "items": {"type": "string"}},
          "blockers": {"type": "array", "items": {"type": "string"}},
          "sources": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "attachmentConcepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "bestFit", "risks", "requiredControls"],
        "properties": {
          "id": {"type": "string"},
          "status": {"type": "string"},
          "bestFit": {"type": "array", "items": {"type": "string"}},
          "risks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "requiredControls": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "promotionGate": {
      "type": "object",
      "required": [
        "exactMaterialGradeSelected",
        "productionProcessSelected",
        "productionIntentSamplesBuilt",
        "assemblyMassesControlled",
        "attachmentDetailFrozen",
        "proofLoadPassed",
        "fatigueTestPassed",
        "failureRetentionResolved",
        "opticalCosmeticStandardFrozen",
        "productionMassToleranceFrozen",
        "supplierQualityReturnsAccepted"
      ],
      "additionalProperties": {"type": "boolean"}
    }
  },
  "additionalProperties": true
}
