{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruddvz.github.io/Aether/schemas/aether-kinetic-rfq.schema.json",
  "title": "AETHERIA VX4800 kinetic supplier RFQ requirements",
  "type": "object",
  "required": ["schemaVersion", "fixtureId", "rfqRevision", "status", "supplierPackages", "commonSubmittals", "releaseRule"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"type": "string"},
    "fixtureId": {"const": "vx4800-bf-01"},
    "rfqRevision": {"type": "string"},
    "status": {"type": "string"},
    "supplierPackages": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "scope", "selectionStatus", "informationToSupplier", "requiredSupplierResponse", "prohibitedAssumptions"],
        "properties": {
          "id": {"type": "string"},
          "scope": {"type": "string"},
          "selectionStatus": {"enum": ["rfq-study-only", "shortlisted-not-selected", "selected"]},
          "informationToSupplier": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "requiredSupplierResponse": {"type": "array", "minItems": 2, "items": {"type": "string"}},
          "prohibitedAssumptions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "commonSubmittals": {"type": "array", "minItems": 5, "items": {"type": "string"}},
    "releaseRule": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
