{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetheria.example/schemas/aether-product-release-gate.schema.json",
  "title": "AETHERIA Product Release Gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fixtureId",
    "designRevision",
    "authority",
    "status",
    "purpose",
    "validationBoundary",
    "evidenceClasses",
    "standardsTargets",
    "releaseStages",
    "evidenceMatrix",
    "promotionGate",
    "rules"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"type": "string"},
    "fixtureId": {"type": "string", "minLength": 1},
    "designRevision": {"type": "string", "minLength": 1},
    "authority": {
      "type": "string",
      "enum": ["qualification-plan", "controlled-release"]
    },
    "status": {
      "type": "string",
      "enum": ["open", "approved"]
    },
    "purpose": {"type": "string", "minLength": 1},
    "validationBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingPackageValidation",
        "existingPackageValidationMeaning",
        "existingPackageValidationIsCertification",
        "githubCiIsPhysicalTestEvidence",
        "githubCiIsCertificationEvidence",
        "physicalQualificationRequired",
        "thirdPartyOrCertificationBodyEvidenceRequiredWhereApplicable"
      ],
      "properties": {
        "existingPackageValidation": {"type": "string"},
        "existingPackageValidationMeaning": {"type": "string"},
        "existingPackageValidationIsCertification": {"type": "boolean"},
        "githubCiIsPhysicalTestEvidence": {"type": "boolean"},
        "githubCiIsCertificationEvidence": {"type": "boolean"},
        "physicalQualificationRequired": {"type": "boolean"},
        "thirdPartyOrCertificationBodyEvidenceRequiredWhereApplicable": {"type": "boolean"}
      }
    },
    "evidenceClasses": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "canClosePhysicalTest"],
        "properties": {
          "id": {
            "type": "string",
            "enum": ["REPOSITORY", "SUPPLIER", "ENGINEERING", "PHYSICAL", "THIRD_PARTY"]
          },
          "description": {"type": "string", "minLength": 1},
          "canClosePhysicalTest": {"type": "boolean"}
        }
      }
    },
    "standardsTargets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "market", "status", "documents"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "market": {"type": "string", "minLength": 1},
          "status": {
            "type": "string",
            "enum": ["target-applicability-review", "applicability-confirmed", "certified"]
          },
          "documents": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["standard", "title", "basis"],
              "properties": {
                "standard": {"type": "string", "minLength": 1},
                "title": {"type": "string", "minLength": 1},
                "edition": {"type": "string"},
                "publicationDate": {"type": "string", "format": "date"},
                "basis": {"type": "string", "minLength": 1}
              }
            }
          },
          "testReportFramework": {"type": "string"},
          "applicabilityNote": {"type": "string"},
          "regulatoryNote": {"type": "string"}
        }
      }
    },
    "releaseStages": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "meaning", "currentStatus"],
        "properties": {
          "id": {
            "type": "string",
            "enum": ["DESIGN_REVIEW", "PROTOTYPE_TEST", "FIRST_ARTICLE", "CONSTRUCTION_RELEASE", "PRODUCTION_RELEASE"]
          },
          "meaning": {"type": "string", "minLength": 1},
          "currentStatus": {
            "type": "string",
            "enum": ["not-released", "partially-satisfied", "released"]
          }
        }
      }
    },
    "evidenceMatrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "domain", "requirement", "requiredEvidence", "requiredFor", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
          "domain": {"type": "string", "minLength": 1},
          "requirement": {"type": "string", "minLength": 1},
          "requiredEvidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": ["REPOSITORY", "SUPPLIER", "ENGINEERING", "PHYSICAL", "THIRD_PARTY"]
            }
          },
          "requiredFor": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": ["DESIGN_REVIEW", "PROTOTYPE_TEST", "FIRST_ARTICLE", "CONSTRUCTION_RELEASE", "PRODUCTION_RELEASE"]
            }
          },
          "status": {
            "type": "string",
            "enum": ["open", "in-progress", "passed", "not-applicable"]
          }
        }
      }
    },
    "promotionGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standardsApplicabilityConfirmed",
        "exactReleasedConfigurationControlled",
        "actualInstalledMassControlled",
        "rotatingMassAndCenterOfGravityControlled",
        "structuralCalculationApproved",
        "suspensionSystemQualified",
        "butterflyMaterialAttachmentQualified",
        "kineticMechanismQualified",
        "dynamicClearanceValidated",
        "electricalArchitectureControlled",
        "electricalSafetyTestsPassed",
        "thermalEnduranceTestsPassed",
        "exactPhotometryControlled",
        "fullFactoryPreHangPassed",
        "serviceabilityValidated",
        "firstArticleInspectionPassed",
        "technicalConstructionFileComplete",
        "constructionReleaseApproved",
        "productionReleaseApproved"
      ],
      "properties": {
        "standardsApplicabilityConfirmed": {"type": "boolean"},
        "exactReleasedConfigurationControlled": {"type": "boolean"},
        "actualInstalledMassControlled": {"type": "boolean"},
        "rotatingMassAndCenterOfGravityControlled": {"type": "boolean"},
        "structuralCalculationApproved": {"type": "boolean"},
        "suspensionSystemQualified": {"type": "boolean"},
        "butterflyMaterialAttachmentQualified": {"type": "boolean"},
        "kineticMechanismQualified": {"type": "boolean"},
        "dynamicClearanceValidated": {"type": "boolean"},
        "electricalArchitectureControlled": {"type": "boolean"},
        "electricalSafetyTestsPassed": {"type": "boolean"},
        "thermalEnduranceTestsPassed": {"type": "boolean"},
        "exactPhotometryControlled": {"type": "boolean"},
        "fullFactoryPreHangPassed": {"type": "boolean"},
        "serviceabilityValidated": {"type": "boolean"},
        "firstArticleInspectionPassed": {"type": "boolean"},
        "technicalConstructionFileComplete": {"type": "boolean"},
        "constructionReleaseApproved": {"type": "boolean"},
        "productionReleaseApproved": {"type": "boolean"}
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
