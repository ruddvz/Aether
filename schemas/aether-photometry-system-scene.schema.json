{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetheria.example/schemas/aether-photometry-system-scene.schema.json",
  "title": "AETHERIA VX4800 photometry system scene",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "fixtureId", "designRevision", "authority", "status", "coordinateSystem", "bindings", "controlState", "sources", "heads", "sensors", "acceptanceCriteria"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schemaVersion": {"const": "1.0.0"},
    "fixtureId": {"const": "vx4800-bf-01"},
    "designRevision": {"const": "1.3.0"},
    "authority": {"enum": ["synthetic-pipeline-test", "controlled-system-review-input"]},
    "status": {"enum": ["synthetic-test-only", "open", "controlled"]},
    "coordinateSystem": {"const": "ceiling XY; z-positive-down"},
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ledSetoutPath", "ledSetoutSha256", "roleSetPath", "roleSetSha256"],
      "properties": {
        "ledSetoutPath": {"type": "string", "minLength": 1},
        "ledSetoutSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "roleSetPath": {"type": ["string", "null"]},
        "roleSetSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "controlState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headPositions", "headRoles", "headAiming", "sensorDefinitions", "acceptanceCriteria"],
      "properties": {
        "headPositions": {"enum": ["controlled", "not-controlled"]},
        "headRoles": {"enum": ["synthetic-test-only", "controlled", "not-controlled"]},
        "headAiming": {"enum": ["synthetic-test-only", "controlled", "not-controlled"]},
        "sensorDefinitions": {"enum": ["synthetic-test-only", "controlled", "not-controlled"]},
        "acceptanceCriteria": {"enum": ["not-released", "released"]}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "configurationId", "iesPath", "iesSha256", "provenanceStatus", "syntheticTest"],
        "properties": {
          "role": {"enum": ["deep-tail narrow", "mid-field spot", "upper-field flood"]},
          "configurationId": {"type": "string", "minLength": 1},
          "iesPath": {"type": "string", "minLength": 1},
          "iesSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "provenanceStatus": {"enum": ["synthetic-test", "supplier", "laboratory"]},
          "syntheticTest": {"type": "boolean"}
        }
      }
    },
    "heads": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ledId", "role", "positionM", "aimDirection", "rollDeg", "outputScale"],
        "properties": {
          "ledId": {"type": "string", "pattern": "^LED-(0[1-9]|1[0-4])$"},
          "role": {"enum": ["deep-tail narrow", "mid-field spot", "upper-field flood"]},
          "positionM": {"$ref": "#/$defs/vector3"},
          "aimDirection": {"$ref": "#/$defs/vector3"},
          "rollDeg": {"type": "number"},
          "outputScale": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "sensors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sensorId", "category", "pointM", "normal"],
        "properties": {
          "sensorId": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "category": {"enum": ["target", "spill", "reference"]},
          "pointM": {"$ref": "#/$defs/vector3"},
          "normal": {"$ref": "#/$defs/vector3"}
        }
      }
    },
    "acceptanceCriteria": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sensorLimits"],
      "properties": {
        "status": {"enum": ["not-released", "released"]},
        "sensorLimits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sensorId"],
            "properties": {
              "sensorId": {"type": "string", "minLength": 1},
              "minimumLux": {"type": "number", "minimum": 0},
              "maximumLux": {"type": "number", "minimum": 0}
            },
            "anyOf": [
              {"required": ["minimumLux"]},
              {"required": ["maximumLux"]}
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"authority": {"const": "synthetic-pipeline-test"}}},
      "then": {
        "properties": {
          "status": {"const": "synthetic-test-only"},
          "bindings": {
            "properties": {
              "roleSetPath": {"const": null},
              "roleSetSha256": {"const": null}
            }
          },
          "controlState": {
            "properties": {
              "headRoles": {"const": "synthetic-test-only"},
              "headAiming": {"const": "synthetic-test-only"},
              "sensorDefinitions": {"const": "synthetic-test-only"},
              "acceptanceCriteria": {"const": "not-released"}
            }
          },
          "acceptanceCriteria": {"properties": {"status": {"const": "not-released"}, "sensorLimits": {"maxItems": 0}}}
        }
      }
    },
    {
      "if": {"properties": {"authority": {"const": "controlled-system-review-input"}, "status": {"const": "controlled"}}},
      "then": {
        "properties": {
          "bindings": {
            "properties": {
              "roleSetPath": {"type": "string", "minLength": 1},
              "roleSetSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          },
          "controlState": {
            "properties": {
              "headPositions": {"const": "controlled"},
              "headRoles": {"const": "controlled"},
              "headAiming": {"const": "controlled"},
              "sensorDefinitions": {"const": "controlled"},
              "acceptanceCriteria": {"const": "released"}
            }
          },
          "acceptanceCriteria": {"properties": {"status": {"const": "released"}, "sensorLimits": {"minItems": 1}}}
        }
      }
    }
  ]
}
