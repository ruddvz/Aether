{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetheria.example/schemas/aether-installation-commissioning-plan.schema.json",
  "title": "AETHERIA Installation and Commissioning Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fixtureId", "designRevision", "authority", "status", "purpose", "boundaries", "controlledBaseline", "siteStages", "preconditions", "installationEvidence", "siteChangeControl", "baselineRecords", "promotionGate", "rules"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"type": "string"},
    "fixtureId": {"type": "string", "minLength": 1},
    "designRevision": {"type": "string", "minLength": 1},
    "authority": {"type": "string", "enum": ["qualification-plan", "controlled"]},
    "status": {"type": "string", "enum": ["open", "approved"]},
    "purpose": {"type": "string", "minLength": 1},
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factoryAcceptanceIsSiteAcceptance", "coordinationCadIsInstallationAuthority", "blenderIsInstallationAuthority", "falseCeilingCanSupportFixture", "siteStructuralApprovalRequiredBeforePermanentLoadTransfer", "releasedInstallationPackageRequired", "siteConfigurationMustMatchReleasedBuild", "uncontrolledSiteModificationPermitted", "commissioningCannotOverrideMechanicalSafetyLimits"],
      "properties": {
        "factoryAcceptanceIsSiteAcceptance": {"type": "boolean"},
        "coordinationCadIsInstallationAuthority": {"type": "boolean"},
        "blenderIsInstallationAuthority": {"type": "boolean"},
        "falseCeilingCanSupportFixture": {"type": "boolean"},
        "siteStructuralApprovalRequiredBeforePermanentLoadTransfer": {"type": "boolean"},
        "releasedInstallationPackageRequired": {"type": "boolean"},
        "siteConfigurationMustMatchReleasedBuild": {"type": "boolean"},
        "uncontrolledSiteModificationPermitted": {"type": "boolean"},
        "commissioningCannotOverrideMechanicalSafetyLimits": {"type": "boolean"}
      }
    },
    "controlledBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elementCount", "sizeAllocation", "fixedAccentHeadCount", "interfaceZoneCount", "sitePrimarySupport", "lightingLocation", "rotatingFieldPlannedElectricalLoads", "nominalMotionRpm", "minimumMotionRpm", "maximumMotionRpm"],
      "properties": {
        "elementCount": {"type": "integer", "const": 240},
        "sizeAllocation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["S", "M", "L"],
          "properties": {"S": {"type": "integer", "const": 66}, "M": {"type": "integer", "const": 144}, "L": {"type": "integer", "const": 30}}
        },
        "fixedAccentHeadCount": {"type": "integer", "const": 14},
        "interfaceZoneCount": {"type": "integer", "const": 8},
        "sitePrimarySupport": {"type": "string", "minLength": 1},
        "lightingLocation": {"type": "string", "const": "fixed-canopy"},
        "rotatingFieldPlannedElectricalLoads": {"type": "boolean"},
        "nominalMotionRpm": {"type": "number"},
        "minimumMotionRpm": {"type": "number"},
        "maximumMotionRpm": {"type": "number"}
      }
    },
    "siteStages": {
      "type": "array", "minItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "releaseStatus", "requirements"],
        "properties": {
          "id": {"type": "string", "enum": ["SITE-RECEIPT", "STRUCTURAL-INSTALLATION", "FIXTURE-ASSEMBLY", "LIGHTING-ELECTRICAL-COMMISSIONING", "KINETIC-COMMISSIONING", "HANDOVER-SERVICE-BASELINE"]},
          "releaseStatus": {"type": "string", "enum": ["not-released", "released"]},
          "requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "preconditions": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "status", "requirement"], "properties": {"id": {"type": "string"}, "status": {"type": "string", "enum": ["open", "satisfied"]}, "requirement": {"type": "string", "minLength": 1}}}
    },
    "installationEvidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "status", "requiredEvidence", "requirement"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
          "status": {"type": "string", "enum": ["open", "in-progress", "passed", "not-applicable"]},
          "requiredEvidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["REPOSITORY", "SUPPLIER", "ENGINEERING", "PHYSICAL", "THIRD_PARTY"]}},
          "requirement": {"type": "string", "minLength": 1},
          "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^EVID-[A-Z0-9-]+$"}},
          "dispositionRef": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {"if": {"properties": {"status": {"const": "passed"}}, "required": ["status"]}, "then": {"required": ["evidenceRefs"]}},
          {"if": {"properties": {"status": {"const": "not-applicable"}}, "required": ["status"]}, "then": {"required": ["dispositionRef"]}}
        ]
      }
    },
    "siteChangeControl": {"type": "object", "additionalProperties": {"type": "boolean"}, "minProperties": 8},
    "baselineRecords": {"type": "object", "additionalProperties": {"type": "boolean"}, "minProperties": 10},
    "promotionGate": {"type": "object", "minProperties": 15, "additionalProperties": {"type": "boolean"}},
    "rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
