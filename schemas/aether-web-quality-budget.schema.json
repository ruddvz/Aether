{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AETHERIA web quality budget",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "status", "authority", "purpose", "toolchain", "browserMatrix", "lighthouse", "global", "routes", "notes"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": "1.0.0"},
    "status": {"const": "active"},
    "authority": {"const": "repository-quality-gate"},
    "purpose": {"type": "string", "minLength": 20},
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeMajor", "playwright", "lighthouse", "chromeLauncher"],
      "properties": {
        "nodeMajor": {"type": "integer", "minimum": 22},
        "playwright": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "lighthouse": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "chromeLauncher": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "browserMatrix": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    },
    "lighthouse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "mode", "scoreEnforcement", "categories", "formFactors", "maxAttempts", "maxWaitForFcpMs", "maxWaitForLoadMs", "realtimeRouteIds", "realtimeLoadProfile"],
      "properties": {
        "enabled": {"const": true},
        "mode": {"const": "report-production"},
        "scoreEnforcement": {"const": false},
        "categories": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"enum": ["performance", "accessibility", "best-practices", "seo"]}
        },
        "formFactors": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["mobile", "desktop"]}
        },
        "maxAttempts": {"type": "integer", "minimum": 1, "maximum": 3},
        "maxWaitForFcpMs": {"type": "integer", "minimum": 10000, "maximum": 60000},
        "maxWaitForLoadMs": {"type": "integer", "minimum": 10000, "maximum": 90000},
        "realtimeRouteIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
        },
        "realtimeLoadProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pauseAfterFcpMs", "pauseAfterLoadMs", "networkQuietThresholdMs", "cpuQuietThresholdMs", "disableFullPageScreenshot"],
          "properties": {
            "pauseAfterFcpMs": {"const": 0},
            "pauseAfterLoadMs": {"const": 0},
            "networkQuietThresholdMs": {"const": 0},
            "cpuQuietThresholdMs": {"const": 0},
            "disableFullPageScreenshot": {"const": true}
          }
        }
      }
    },
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxPublishedTreeBytes", "maxSinglePublishedFileBytes", "zipFilesPermitted", "forbiddenUrlFragments", "allowedExternalHosts"],
      "properties": {
        "maxPublishedTreeBytes": {"type": "integer", "minimum": 1},
        "maxSinglePublishedFileBytes": {"type": "integer", "minimum": 1},
        "zipFilesPermitted": {"const": false},
        "forbiddenUrlFragments": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
        "allowedExternalHosts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3}}
      }
    },
    "routes": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "htmlFile", "requiredSelector", "maxHtmlBytes"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "path": {"type": "string", "pattern": "^/"},
          "htmlFile": {"type": "string", "pattern": "\\.html$"},
          "requiredSelector": {"type": "string", "minLength": 1},
          "maxHtmlBytes": {"type": "integer", "minimum": 1024}
        }
      }
    },
    "notes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}}
  }
}
