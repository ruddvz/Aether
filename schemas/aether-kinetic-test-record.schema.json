{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruddvz.github.io/Aether/schemas/aether-kinetic-test-record.schema.json",
  "title": "AETHERIA VX4800 kinetic physical test record",
  "type": "object",
  "required": ["schemaVersion", "fixtureId", "testCaseId", "recordId", "configuration", "performedAt", "equipment", "acceptanceCriteria", "measurements", "evidence", "result"],
  "properties": {
    "schemaVersion": {"type": "string"},
    "fixtureId": {"const": "vx4800-bf-01"},
    "testCaseId": {"type": "string", "minLength": 1},
    "recordId": {"type": "string", "minLength": 1},
    "configuration": {
      "type": "object",
      "required": ["designRevision", "kineticRevision", "articleId", "configurationRefs"],
      "properties": {
        "designRevision": {"const": "1.3.0"},
        "kineticRevision": {"type": "string", "minLength": 1},
        "articleId": {"type": "string", "minLength": 1},
        "configurationRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    },
    "performedAt": {"type": "string", "format": "date-time"},
    "operator": {"type": ["string", "null"]},
    "equipment": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "function", "calibrationStatus"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "function": {"type": "string", "minLength": 1},
          "calibrationStatus": {"enum": ["in-date", "verified", "not-applicable"]},
          "calibrationRef": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "acceptanceCriteria": {
      "type": "object",
      "required": ["controlled", "revision", "criteria"],
      "properties": {
        "controlled": {"type": "boolean"},
        "revision": {"type": ["string", "null"]},
        "criteria": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "measurements": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "result": {
      "type": "object",
      "required": ["status", "deviations", "disposition"],
      "properties": {
        "status": {"enum": ["planned", "incomplete", "passed", "failed"]},
        "deviations": {"type": "array", "items": {"type": "string"}},
        "disposition": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"properties": {"status": {"const": "passed"}}, "required": ["status"]}}},
      "then": {
        "properties": {
          "acceptanceCriteria": {
            "properties": {
              "controlled": {"const": true},
              "revision": {"type": "string", "minLength": 1},
              "criteria": {"minItems": 1}
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
