{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruddvz.github.io/Aether/schemas/aether-fixture.schema.json",
  "title": "AETHERIA Fixture Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "identity", "classification", "physical", "assets", "provenance"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixtureId", "productCode", "brand", "name", "designRevision", "lifecycle"],
      "properties": {
        "fixtureId": {"type": "string", "minLength": 1},
        "productCode": {"type": "string", "minLength": 1},
        "brand": {"type": "string", "minLength": 1},
        "collection": {"type": "string"},
        "name": {"type": "string", "minLength": 1},
        "designRevision": {"type": "string"},
        "presentationRevision": {"type": "string"},
        "lifecycle": {"enum": ["concept", "prototype", "rfq", "engineering", "production", "retired"]},
        "description": {"type": "string"}
      }
    },
    "classification": {
      "type": "object",
      "required": ["fixtureType", "motion"],
      "properties": {
        "fixtureType": {"type": "string"},
        "motion": {"enum": ["static", "kinetic"]},
        "applications": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "environment": {"type": "string"}
      }
    },
    "physical": {
      "type": "object",
      "required": ["envelopeMm"],
      "properties": {
        "envelopeMm": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "exclusiveMinimum": 0}},
        "canopyEnvelopeMm": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "exclusiveMinimum": 0}},
        "maximumDropMm": {"type": "number", "exclusiveMinimum": 0},
        "massKg": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "value": {"type": "number", "exclusiveMinimum": 0},
            "status": {"enum": ["unknown", "estimated", "calculated", "measured"]}
          }
        },
        "mounting": {"type": "object"}
      }
    },
    "optical": {"type": "object"},
    "composition": {"type": "object"},
    "kinematics": {"type": "object"},
    "electrical": {"type": "object"},
    "materials": {"type": "array"},
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "path", "format", "authority", "sha256"],
        "properties": {
          "id": {"type": "string"},
          "role": {"type": "string"},
          "path": {"type": "string"},
          "format": {"type": "string"},
          "authority": {"enum": ["reference", "visual", "coordination", "manufacturing", "controlled"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "units": {"type": "string"},
          "coordinateSystem": {"type": "string"}
        }
      }
    },
    "interchange": {"type": "object"},
    "manufacturing": {"type": "object"},
    "compliance": {"type": "object"},
    "provenance": {
      "type": "object",
      "required": ["createdAt", "updatedAt", "authors"],
      "properties": {
        "createdAt": {"type": "string"},
        "updatedAt": {"type": "string"},
        "authors": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "sourceReferences": {"type": "array", "items": {"type": "string"}}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
