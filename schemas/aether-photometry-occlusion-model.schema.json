{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetheria.example/schemas/aether-photometry-occlusion-model.schema.json",
  "title": "AETHERIA VX4800 photometry occlusion model",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "fixtureId", "designRevision", "authority", "status", "coordinateSystem", "bindings", "controlState", "objects", "acceptanceCriteria"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schemaVersion": {"const": "1.0.0"},
    "fixtureId": {"const": "vx4800-bf-01"},
    "designRevision": {"const": "1.3.0"},
    "authority": {"enum": ["synthetic-pipeline-test", "controlled-occlusion-input"]},
    "status": {"enum": ["synthetic-test-only", "open", "controlled"]},
    "coordinateSystem": {"const": "ceiling XY; z-positive-down"},
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["systemScenePath", "systemSceneSha256"],
      "properties": {
        "systemScenePath": {"type": "string", "minLength": 1},
        "systemSceneSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "controlState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geometry", "directTransmissionAssumptions", "coverageComplete"],
      "properties": {
        "geometry": {"enum": ["synthetic-test-only", "controlled", "not-controlled"]},
        "directTransmissionAssumptions": {"enum": ["synthetic-test-only", "controlled", "not-controlled"]},
        "coverageComplete": {"type": "boolean"}
      }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["objectId", "category", "directTransmissionFactor", "sourceReference", "sourceSha256", "triangles"],
        "properties": {
          "objectId": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "category": {"enum": ["canopy", "carrier", "butterfly-field", "architecture", "other"]},
          "directTransmissionFactor": {"type": "number", "minimum": 0, "maximum": 1},
          "sourceReference": {"type": ["string", "null"]},
          "sourceSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "triangles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {"$ref": "#/$defs/vector3"}
            }
          }
        }
      }
    },
    "acceptanceCriteria": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sensorLimits"],
      "properties": {
        "status": {"enum": ["not-released", "released"]},
        "sensorLimits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sensorId"],
            "properties": {
              "sensorId": {"type": "string", "minLength": 1},
              "maximumLossFraction": {"type": "number", "minimum": 0, "maximum": 1},
              "minimumOccludedLux": {"type": "number", "minimum": 0}
            },
            "anyOf": [{"required": ["maximumLossFraction"]}, {"required": ["minimumOccludedLux"]}]
          }
        }
      }
    }
  },
  "$defs": {
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"authority": {"const": "synthetic-pipeline-test"}}},
      "then": {
        "properties": {
          "status": {"const": "synthetic-test-only"},
          "controlState": {
            "properties": {
              "geometry": {"const": "synthetic-test-only"},
              "directTransmissionAssumptions": {"const": "synthetic-test-only"},
              "coverageComplete": {"const": false}
            }
          },
          "acceptanceCriteria": {"properties": {"status": {"const": "not-released"}, "sensorLimits": {"maxItems": 0}}},
          "objects": {"items": {"properties": {"sourceReference": {"const": null}, "sourceSha256": {"const": null}}}}
        }
      }
    },
    {
      "if": {"properties": {"authority": {"const": "controlled-occlusion-input"}, "status": {"const": "controlled"}}},
      "then": {
        "properties": {
          "controlState": {
            "properties": {
              "geometry": {"const": "controlled"},
              "directTransmissionAssumptions": {"const": "controlled"},
              "coverageComplete": {"const": true}
            }
          },
          "acceptanceCriteria": {"properties": {"status": {"const": "released"}, "sensorLimits": {"minItems": 1}}},
          "objects": {
            "items": {
              "properties": {
                "sourceReference": {"type": "string", "minLength": 1},
                "sourceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    }
  ]
}
